{
  "name": "aural",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace @aural/desktop run dev",
    "build": "npm --workspace @aural/desktop run build",
    "typecheck": "npm --workspaces --if-present --include-workspace-root=false run typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.0.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}

