    
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Main Process (apps/desktop/main)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/desktop",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd"
      },
      "args": ["."],
      "sourceMaps": true,
      // 5. 指定编译后的文件位置（必须和你的 vite 配置一致）
      "outFiles": ["${workspaceFolder}/apps/desktop/dist-electron/**/*.js"],
      // 6. 日志输出到 VS Code 终端，方便查看启动错误
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
    }
  ]
}